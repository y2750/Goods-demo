<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- namespace等于mapper接口类的全限定名 -->
<mapper namespace="com.example.mall.module.mapper.GoodsMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="goods.id">
        INSERT INTO goods(
        category_id,
        <if test="goods.title != null and goods.title != ''">title,</if>
        <if test="goods.images != null and goods.images != ''">images,</if>
        <if test="goods.price != null">price,</if>
        <if test="goods.description != null and goods.description != ''">description,</if>
        <if test="goods.createTime != null">create_time,</if>
        <if test="goods.updateTime != null">update_time,</if>
        is_deleted
        )
        VALUES(
        #{goods.categoryId},
        <if test="goods.title != null and goods.title != ''">#{goods.title},</if>
        <if test="goods.images != null and goods.images != ''">#{goods.images},</if>
        <if test="goods.price != null">#{goods.price},</if>
        <if test="goods.description != null and goods.description != ''">#{goods.description},</if>
        <if test="goods.createTime != null">#{goods.createTime},</if>
        <if test="goods.updateTime != null">#{goods.updateTime},</if>
        0
        )
    </insert>

    <update id="update">
        UPDATE goods
        <set>
            <if test="goods.categoryId != null">
                category_id = #{goods.categoryId},
            </if>
            <if test="goods.title != null and goods.title != ''">
                title = #{goods.title},
            </if>
            <if test="goods.images != null and goods.images != ''">
                images = #{goods.images},
            </if>
            <if test="goods.price != null">
                price = #{goods.price},
            </if>
            <if test="goods.description != null and goods.description != ''">
                description = #{goods.description,jdbcType=VARCHAR},
            </if>
            update_time = #{goods.updateTime}
        </set>
        WHERE id = #{goods.id}
        AND is_deleted = 0
    </update>

    <!-- app：分类 ID 由第一条 SQL 查出，此处是第二条 SQL，没有联表或子查询。 -->
    <select id="getAppGoodsByPage" resultType="com.example.mall.module.entity.Goods">
        SELECT * FROM goods
        <where>
            is_deleted = 0
            <if test="keyword != null and keyword != ''">
                AND (
                    title LIKE #{keyword}
                    <if test="categoryIds != null and categoryIds.size() > 0">
                        OR category_id IN
                        <foreach collection="categoryIds" item="categoryId" open="(" separator="," close=")">
                            #{categoryId}
                        </foreach>
                    </if>
                )
            </if>
        </where>
        ORDER BY id
        LIMIT #{offset}, #{pageSize}
    </select>

    <!-- console：列表和总数复用完全相同的联表与筛选条件。 -->
    <sql id="consoleGoodsFilter">
        FROM goods g
        LEFT JOIN category c ON c.id = g.category_id AND c.is_deleted = 0
        <where>
            g.is_deleted = 0
            <if test="keyword != null and keyword != ''">
                AND (g.title LIKE #{keyword} OR c.name LIKE #{keyword})
            </if>
        </where>
    </sql>

    <select id="getConsoleGoodsByPage" resultType="com.example.mall.module.entity.Goods">
        SELECT g.*, c.name AS categoryName
        <include refid="consoleGoodsFilter"/>
        ORDER BY g.id
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="getConsoleTotal" resultType="java.lang.Integer">
        SELECT COUNT(*)
        <include refid="consoleGoodsFilter"/>
    </select>

</mapper>
