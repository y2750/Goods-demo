<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- namespace等于mapper接口类的全限定名 -->
<mapper namespace="com.example.mall.module.mapper.GoodsMapper">

    <insert id="insert" useGeneratedKeys="true" keyProperty="goods.id">
        INSERT INTO goods(
        <if test="goods.title != null and goods.title != ''">title,</if>
        <if test="goods.images != null and goods.images != ''">images,</if>
        <if test="goods.price != null">price,</if>
        <if test="goods.description != null and goods.description != ''">description,</if>
        <if test="goods.createTime != null">create_time,</if>
        <if test="goods.updateTime != null">update_time,</if>
        is_deleted
        )
        VALUES(
        <if test="goods.title != null and goods.title != ''">#{goods.title},</if>
        <if test="goods.images != null and goods.images != ''">#{goods.images},</if>
        <if test="goods.price != null">#{goods.price},</if>
        <if test="goods.description != null and goods.description != ''">#{goods.description},</if>
        <if test="goods.createTime != null">#{goods.createTime},</if>
        <if test="goods.updateTime != null">#{goods.updateTime},</if>
        0
        )
    </insert>

    <update id="update">
        UPDATE goods
        <set>
            <if test="goods.title != null and goods.title != ''">
                title = #{goods.title},
            </if>
            <if test="goods.images != null and goods.images != ''">
                images = #{goods.images},
            </if>
            <if test="goods.price != null">
                price = #{goods.price},
            </if>
            <if test="goods.description != null and goods.description != ''">
                description = #{goods.description,jdbcType=VARCHAR},
            </if>
            update_time = #{goods.updateTime}
        </set>
        WHERE id = #{goods.id}
        AND is_deleted = 0
    </update>

    <select id="getGoodsByPage" resultType="com.example.mall.module.entity.Goods">
        SELECT * FROM goods
        <where>
            is_deleted = 0
            <if test="keyword != null and keyword != ''">
                AND title LIKE #{keyword}
            </if>
        </where>
        ORDER BY id
        LIMIT #{offset}, #{pageSize}
    </select>

</mapper>
