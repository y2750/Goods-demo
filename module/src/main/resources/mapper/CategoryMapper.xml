<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mall.module.mapper.CategoryMapper">

    <!-- 自增主键不参与 INSERT；通过 entity.id 回填。只跳过 null，允许空字符串。 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="entity.id" keyColumn="id">
        INSERT INTO `category`
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="entity.name != null">`name`,</if>
            <if test="entity.image != null">`image`,</if>
            <if test="entity.createTime != null">`create_time`,</if>
            <if test="entity.updateTime != null">`update_time`,</if>
            `is_deleted`
        </trim>
        VALUES
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="entity.name != null">#{entity.name},</if>
            <if test="entity.image != null">#{entity.image},</if>
            <if test="entity.createTime != null">#{entity.createTime},</if>
            <if test="entity.updateTime != null">#{entity.updateTime},</if>
            0
        </trim>
    </insert>

    <!-- 创建时间和删除状态不通过普通修改接口更新。 -->
    <update id="update">
        UPDATE `category`
        <set>
            <if test="entity.name != null">
                `name` = #{entity.name},
            </if>
            <if test="entity.image != null">
                `image` = #{entity.image},
            </if>
            `update_time` = #{entity.updateTime}
        </set>
        WHERE `id` = #{entity.id}
          AND `is_deleted` = 0
    </update>
</mapper>
